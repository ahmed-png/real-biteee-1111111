# ===== Discord Bot Configuration =====
# انسخ هذا الملف باسم .env وضع قيمك الحقيقية

# ─── توكن البوت (من Discord Developer Portal) ───────────
DISCORD_TOKEN=your_bot_token_here

# ─── معرف مالك البوت ─────────────────────────────────────
OWNER_ID=your_discord_user_id_here

# ─── مفتاح Gemini AI API ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── مفتاح YouTube Data API v3 ───────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── HuggingFace Token ────────────────────────────────────
HF_TOKEN=your_hf_token_here

# ─── OpenRouter API (بديل/مساعد للذكاء الاصطناعي) ───────────────
# سجّل في https://openrouter.ai واحصل على مفتاح مجاني
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── لوحة التحكم الاحترافية ──────────────────────────────
# مفتاح أمان الداشبورد (اتركه فارغاً ليُولَّد تلقائياً)
# DASHBOARD_KEY=your_secret_key_here

# المنفذ (Render يعيّنه تلقائياً — لا تغيّره على Render)
# PORT=3000

# ─── Render (يُعيَّن تلقائياً من Render) ─────────────────
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
